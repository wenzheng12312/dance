<view class="coach-page">
  <view class="coach-hero">
    <text class="eyebrow">视频动作诊断</text>
    <text class="title">AI动作陪练</text>
    <text class="summary">录制或上传一段练习视频，系统只给动作建议，不做分数评价。</text>
  </view>

  <view class="section-title">选择练习动作</view>
  <scroll-view class="action-scroll" scroll-x>
    <view
      class="action-pill {{activeActionId === item.id ? 'active' : ''}}"
      wx:for="{{actions}}"
      wx:key="id"
      bindtap="selectAction"
      data-id="{{item.id}}"
    >
      <text class="action-name">{{item.name}}</text>
      <text class="action-level">{{item.level}}</text>
    </view>
  </scroll-view>

  <view class="reference-panel" wx:if="{{selectedAction}}">
    <view class="reference-copy">
      <text class="panel-label">观察重点</text>
      <text class="panel-title">{{selectedAction.name}}</text>
      <text class="panel-text">{{selectedAction.reference}}</text>
      <text class="focus">重点：{{selectedAction.focus}}</text>
    </view>
  </view>

  <view class="upload-panel">
    <text class="panel-label">上传练习视频</text>
    <text class="upload-tip">建议上传 15～30 秒视频，画面包含全身，方便观察脚步、重心和手位。</text>
    <view class="upload-actions">
      <button class="upload-btn camera" bindtap="recordVideo" disabled="{{uploading || analyzing}}">手机录制</button>
      <button class="upload-btn album" bindtap="uploadVideo" disabled="{{uploading || analyzing}}">文件上传</button>
    </view>
    <view class="upload-status" wx:if="{{uploading}}">
      <text>正在上传到微信云存储...</text>
    </view>
    <view class="upload-status success" wx:elif="{{videoFileID}}">
      <text>视频已上传，可以生成动作建议</text>
    </view>
  </view>

  <view class="video-preview" wx:if="{{uploadedVideo}}">
    <video class="uploaded-video" src="{{uploadedVideo.tempFilePath}}" controls show-center-play-btn></video>
    <view class="video-meta">
      <text class="video-name">{{uploadedVideo.name}}</text>
      <text class="video-desc">{{uploadedVideo.duration ? uploadedVideo.duration + '秒' : '本地视频'}}</text>
    </view>
  </view>

  <view class="error-panel" wx:if="{{errorMessage}}">
    <text>{{errorMessage}}</text>
  </view>

  <button class="coach-btn" bindtap="analyzeVideo" loading="{{analyzing}}" disabled="{{uploading || analyzing}}">
    {{analyzing ? 'AI正在分析动作...' : '生成动作建议'}}
  </button>

  <view class="result-panel" wx:if="{{analysisResult}}">
    <text class="result-kicker">AI 动作建议</text>
    <text class="result-title">整体表现</text>
    <text class="summary-text">{{analysisResult.summary}}</text>

    <text class="empty-section" wx:if="{{resultFormat === 'text'}}">以下为模型原始评价，暂未生成分项建议。</text>
    <view class="advice-block" wx:if="{{resultFormat !== 'text'}}">
      <text class="block-title">需要调整</text>
      <view class="problem-card" wx:for="{{analysisResult.problems}}" wx:key="index">
        <text class="problem-time">时间：{{item.time}}</text>
        <text class="problem-label">问题</text>
        <text class="problem-text">{{item.problem}}</text>
        <text class="problem-label suggestion-label">建议</text>
        <text class="problem-text">{{item.suggestion}}</text>
      </view>
      <text class="empty-problems" wx:if="{{analysisResult.problems.length === 0}}">暂未发现明显动作问题。</text>
    </view>

    <view class="advice-block" wx:if="{{resultFormat !== 'text'}}">
      <text class="block-title">做得不错</text>
      <text class="good-point" wx:for="{{analysisResult.goodPoints}}" wx:key="index">✓ {{item}}</text>
      <text class="empty-section" wx:if="{{analysisResult.goodPoints.length === 0}}">暂无可明确判断的优点。</text>
    </view>

    <view class="advice-block" wx:if="{{resultFormat !== 'text'}}">
      <text class="block-title">练习建议</text>
      <view class="practice-item" wx:for="{{analysisResult.practiceAdvice}}" wx:key="index">
        <text class="practice-index">{{index + 1}}</text>
        <text class="practice-text">{{item}}</text>
      </view>
      <text class="empty-section" wx:if="{{analysisResult.practiceAdvice.length === 0}}">暂无额外专项练习建议。</text>
    </view>
  </view>
</view>
