.coach-page {
  min-height: 100vh;
  padding: 28rpx;
  background: #eef5f4;
  box-sizing: border-box;
}

.coach-hero {
  padding: 34rpx;
  border-radius: 16rpx;
  background: #294b52;
  color: #fff;
}

.eyebrow {
  display: block;
  font-size: 24rpx;
  color: #a8d7cf;
}

.title {
  display: block;
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 800;
}

.summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.78);
}

.section-title {
  margin: 34rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #243b3d;
}

.action-scroll {
  white-space: nowrap;
}

.action-pill {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 220rpx;
  height: 116rpx;
  margin-right: 18rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #fff;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.action-pill.active {
  border-color: #4d91a8;
  background: #e3f1f3;
}

.action-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #233b3d;
}

.action-level {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f8281;
}

.reference-panel {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #fff;
  display: flex;
  align-items: center;
}

.pose-figure {
  width: 190rpx;
  height: 250rpx;
  border-radius: 16rpx;
  background: #e8f1e8;
  position: relative;
  margin-right: 26rpx;
}

.head, .body, .arm, .leg {
  position: absolute;
  background: #5f9a69;
}

.head {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  left: 74rpx;
  top: 28rpx;
}

.body {
  width: 22rpx;
  height: 86rpx;
  left: 84rpx;
  top: 76rpx;
  border-radius: 999rpx;
}

.arm, .leg {
  width: 18rpx;
  height: 86rpx;
  border-radius: 999rpx;
  transform-origin: top center;
}

.left-arm {
  left: 76rpx;
  top: 86rpx;
  transform: rotate(48deg);
}

.right-arm {
  left: 98rpx;
  top: 86rpx;
  transform: rotate(-56deg);
}

.left-leg {
  left: 82rpx;
  top: 154rpx;
  transform: rotate(24deg);
}

.right-leg {
  left: 94rpx;
  top: 154rpx;
  transform: rotate(-28deg);
}

.reference-copy {
  flex: 1;
}

.panel-label {
  display: block;
  font-size: 22rpx;
  color: #5b8b69;
}

.panel-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #22352a;
}

.panel-text, .focus {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #69756e;
  line-height: 1.45;
}

.focus {
  color: #31543b;
  font-weight: 700;
}

.coach-btn {
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #d8755b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.result-panel {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
}

.score-block {
  display: flex;
  align-items: baseline;
}

.score {
  font-size: 74rpx;
  color: #d8755b;
  font-weight: 900;
}

.score-label {
  margin-left: 18rpx;
  font-size: 26rpx;
  color: #58645d;
}

.advice-block, .compare {
  margin-top: 24rpx;
}

.result-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #22352a;
}

.advice, .compare-text {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #68766c;
}
