.coach-page {
  min-height: 100vh;
  padding: 28rpx;
  background: #eef5f4;
  box-sizing: border-box;
}

.coach-hero {
  padding: 34rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #294b52 0%, #4d91a8 100%);
  color: #fff;
}

.eyebrow {
  display: block;
  font-size: 24rpx;
  color: #b8e2dc;
}

.title {
  display: block;
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 800;
}

.summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.82);
}

.section-title {
  margin: 34rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #243b3d;
}

.action-scroll {
  white-space: nowrap;
}

.action-pill {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 244rpx;
  height: 118rpx;
  margin-right: 18rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #fff;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.action-pill.active {
  border-color: #4d91a8;
  background: #e3f1f3;
}

.action-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #233b3d;
}

.action-level {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f8281;
}

.reference-panel,
.upload-panel,
.video-preview,
.result-panel {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(41,75,82,0.06);
}

.panel-label,
.result-kicker {
  display: block;
  font-size: 22rpx;
  color: #4d91a8;
  font-weight: 800;
}

.panel-title,
.result-title {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #22352a;
}

.panel-text,
.focus,
.upload-tip,
.result-meta {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #69756e;
  line-height: 1.45;
}

.focus {
  color: #31543b;
  font-weight: 700;
}

.upload-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
}

.upload-btn {
  width: 302rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.upload-btn.camera {
  background: #31543b;
  color: #fff;
}

.upload-btn.album {
  background: #fff0eb;
  color: #d8755b;
}

.uploaded-video {
  width: 100%;
  height: 360rpx;
  border-radius: 14rpx;
  background: #111;
}

.video-meta {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
}

.video-name {
  font-size: 26rpx;
  color: #22352a;
  font-weight: 800;
}

.video-desc {
  font-size: 24rpx;
  color: #7d8b85;
}

.coach-btn {
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #d8755b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.advice-block {
  margin-top: 26rpx;
}

.block-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #22352a;
}

.advice {
  display: block;
  margin-top: 14rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid #dcecc9;
  font-size: 25rpx;
  line-height: 1.55;
  color: #68766c;
}
