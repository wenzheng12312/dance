.container {
  background-color: #fff;
  min-height: 100vh;
}

.video-player {
  width: 100%;
  height: 420rpx;
  background-color: #000;
}

.course-info {
  padding: 30rpx;
}

.video-error {
  margin: 24rpx 30rpx 0;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff0eb;
  color: #b4553f;
  font-size: 24rpx;
  line-height: 1.5;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.meta-row {
  margin-top: 20rpx;
}

.duration {
  font-size: 26rpx;
  color: #ff6b6b;
}

.divider {
  height: 2rpx;
  background-color: #f5f5f5;
  margin: 30rpx 0;
}

.desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.video-url {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
  word-break: break-all;
}
