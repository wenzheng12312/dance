.studio-page {
  min-height: 100vh;
  padding: 28rpx;
  background: #f7f0ea;
  box-sizing: border-box;
}

.studio-hero {
  padding: 34rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #6f3f33 0%, #d8755b 72%, #f4c36a 100%);
  color: #fff;
}

.eyebrow {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
}

.title {
  display: block;
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 800;
}

.summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.82);
}

.demo-notice {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #7c6655;
  font-size: 23rpx;
  line-height: 1.45;
}

.section-head {
  margin-top: 34rpx;
  margin-bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-head.compact {
  margin-top: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #3c3028;
}

.count {
  font-size: 24rpx;
  color: #8d7664;
}

.unit-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.unit-card {
  width: 338rpx;
  min-height: 142rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  color: #fff;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}

.unit-green {
  background: #6e9c52;
}

.unit-blue {
  background: #4d91a8;
}

.unit-coral {
  background: #d8755b;
}

.unit-yellow {
  background: #d7a940;
}

.unit-mint {
  background: #55a889;
}

.unit-purple {
  background: #7c6597;
}

.unit-name {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
}

.unit-meta {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.82);
}

.sequence-panel {
  margin-top: 30rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
}

.empty {
  padding: 42rpx 0;
  text-align: center;
  color: #9b8a7c;
  font-size: 26rpx;
}

.sequence-scroll {
  white-space: nowrap;
}

.sequence-item {
  display: inline-flex;
  align-items: center;
  height: 82rpx;
  padding: 0 22rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #f6eadf;
}

.sequence-index {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  border-radius: 50%;
  text-align: center;
  background: #d8755b;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.sequence-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #4a372e;
  font-weight: 700;
}

.piece-name {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #fff7ee;
  color: #714636;
  font-size: 28rpx;
  font-weight: 800;
}

.actions {
  margin-top: 24rpx;
  display: flex;
}

.ghost-btn, .preview-btn, .save-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.ghost-btn {
  background: #f2e7de;
  color: #6b5144;
  margin-right: 12rpx;
}

.preview-btn {
  background: #d8755b;
  color: #fff;
  margin-right: 12rpx;
}

.save-btn {
  background: #31543b;
  color: #fff;
}

.output-panel {
  margin-top: 30rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
}

.frame-player {
  position: relative;
  width: 100%;
  height: 390rpx;
  border-radius: 14rpx;
  background: #111;
  overflow: hidden;
}

.output-frame {
  width: 100%;
  height: 390rpx;
  background: #111;
}

.play-badge {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(49,84,59,0.82);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.replay-btn {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  min-width: 116rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.9);
  color: #31543b;
  font-size: 23rpx;
  font-weight: 800;
}

.output-meta {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff7ee;
}

.output-title {
  display: block;
  font-size: 28rpx;
  color: #4a372e;
  font-weight: 900;
}

.output-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #8b7462;
}

.output-error {
  display: block;
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  background: #ffe9df;
  color: #a9482e;
  font-size: 22rpx;
  line-height: 1.45;
}
