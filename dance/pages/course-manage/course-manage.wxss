page {
  width: 100%;
}

.container {
  width: 100%;
  display: block;
  padding: 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 列表模式 ========== */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.list-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  background-color: #ff6b6b;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1;
}

/* 课程卡片 */
.course-card {
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
}

.card-main {
  display: flex;
}

.cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background-color: #eee;
}

.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.meta {
  margin-top: 8rpx;
}

.duration {
  font-size: 24rpx;
  color: #ff6b6b;
  background-color: #fff0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-actions {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.action-edit {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  font-size: 26rpx;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background: transparent;
}

.action-delete {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  font-size: 26rpx;
  color: #999;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  margin-left: 16rpx;
  background: transparent;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ========== 表单模式 ========== */
.form-header {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.back-btn {
  font-size: 30rpx;
  color: #ff6b6b;
  margin-right: 20rpx;
  padding: 8rpx 0;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form-card {
  background-color: #fff;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 14rpx;
  display: block;
}

.input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.textarea {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  width: 100%;
  box-sizing: border-box;
  min-height: 240rpx;
  height: 240rpx;
}

/* 上传区域 */
.upload-area {
  display: flex;
  align-items: center;
}

.upload-preview {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  margin-right: 24rpx;
}

.upload-placeholder {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.upload-icon {
  font-size: 48rpx;
  color: #ccc;
}

.upload-btn {
  font-size: 26rpx;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  padding: 16rpx 28rpx;
  border-radius: 8rpx;
  background: transparent;
}

.upload-info {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  word-break: break-all;
}

.submit-btn {
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 50rpx;
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 12rpx 0;
}
