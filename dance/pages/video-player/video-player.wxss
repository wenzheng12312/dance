.container {
  background-color: #fff;
  min-height: 100vh;
}

.video-player {
  width: 100%;
  height: 420rpx;
  background-color: #000;
}

.course-info {
  padding: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.meta-row {
  margin-top: 20rpx;
}

.duration {
  font-size: 26rpx;
  color: #ff6b6b;
}

.divider {
  height: 2rpx;
  background-color: #f5f5f5;
  margin: 30rpx 0;
}

.desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}