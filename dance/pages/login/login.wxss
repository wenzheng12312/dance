.login-container {
  padding: 100rpx 60rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 100rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
  display: block;
}

.form-area {
  background-color: #fff;
  padding: 60rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.input-item {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
}

.login-btn {
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 50rpx;
  margin-top: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.tip {
  text-align: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #999;
}