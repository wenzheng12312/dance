.container {
  width: 100%;
  display: block;
  padding: 30rpx 30rpx 60rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 顶栏 ========== */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.greeting {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.logout {
  font-size: 26rpx;
  color: #b0b0b0;
  padding: 8rpx 0;
}

/* ========== 区域标题 ========== */
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

/* ========== 课程网格（单列流式） ========== */
.course-grid {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

/* ========== 课程卡片：左封面 + 右信息 ========== */
.course-card {
  width: 100%;
  display: flex;
  flex-direction: row;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.meta-row {
  margin-top: 12rpx;
}

.duration-tag {
  font-size: 22rpx;
  color: #ff6b6b;
  background-color: #fff2f2;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* ========== 空状态 ========== */
.empty {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  box-sizing: border-box;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b0b0;
  line-height: 1.6;
}
